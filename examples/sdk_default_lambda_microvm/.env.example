# Settings baked into the UAT default Lambda MicroVM sandbox image (app.py),
# read by the CAS SDK. Copy to .env before building:
#   cp .env.example .env
# The Dockerfile copies .env into the image next to app.py.

# The engine: claude-agent-sdk or gitagent.
COMPUTER_AGENT_ENGINE=claude-agent-sdk

# Not baked: CAS passes these per session in POST /v1/sessions envs, so one
# image runs against whichever egress proxy CAS names:
#   COMPUTER_AGENT_ID                        the AgentOS agent the session runs
#   COMPUTER_AGENT_EGRESS_PROXY_SECRET       the sandbox token (a secret)
#   COMPUTER_AGENT_EGRESS_API_URL            <proxy>/computer-agent-api/agentos/api
#   COMPUTER_AGENT_EGRESS_LLM_URL            <proxy>/llm
#   COMPUTER_AGENT_EGRESS_MCP_URL            <proxy>/mcp/v1
#   COMPUTER_AGENT_EGRESS_GUARDRAILS_URL     <proxy>/guardrails
#   COMPUTER_AGENT_EGRESS_SESSION_STORE_URL  <proxy>/computer-agent-api
#   COMPUTER_AGENT_EGRESS_TELEMETRY_URL      <proxy>/otlp
# Setting a route here pins it: the image's own value wins over CAS's.
