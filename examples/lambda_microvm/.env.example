# Settings of the Lambda MicroVM example app (app.py), read by the CAS SDK.
# Copy to .env and adjust:
#   cp .env.example .env
# The Dockerfile copies .env into the image next to app.py; variables set at
# run time (docker run -e / --env-file) override it.

# The engine: claude-agent-sdk or gitagent.
COMPUTER_AGENT_ENGINE=claude-agent-sdk

# The CAS egress proxy's routes; every SDK call goes through them.
COMPUTER_AGENT_EGRESS_API_URL=https://borrower-reroute-cornball.ngrok-free.dev/computer-agent-api/agentos/api
COMPUTER_AGENT_EGRESS_LLM_URL=https://borrower-reroute-cornball.ngrok-free.dev/llm
COMPUTER_AGENT_EGRESS_MCP_URL=https://borrower-reroute-cornball.ngrok-free.dev/mcp/v1
COMPUTER_AGENT_EGRESS_GUARDRAILS_URL=https://borrower-reroute-cornball.ngrok-free.dev/guardrails
# The http session store (old CAS sends an http sessionStore descriptor per session).
COMPUTER_AGENT_EGRESS_SESSION_STORE_URL=https://borrower-reroute-cornball.ngrok-free.dev/computer-agent-api
# OTLP telemetry (traces, metrics, logs) through the proxy; the Dockerfile installs the [otel] extra.
COMPUTER_AGENT_EGRESS_TELEMETRY_URL=https://borrower-reroute-cornball.ngrok-free.dev/otlp

# Not here: old CAS passes these per session in POST /v1/sessions envs
# (this file is baked into the image):
#   COMPUTER_AGENT_ID                   the AgentOS agent the session runs
#   COMPUTER_AGENT_EGRESS_PROXY_SECRET  the sandbox token (a secret)
